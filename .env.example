# App (use Vite origin when proxying API via npm run dev)
APP_URL=http://localhost:5173

# GitHub OAuth App
# Callback URL must match: {APP_URL}/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session cookie encryption (min 32 chars)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# OpenAI (Step 3+)
OPENAI_API_KEY=

# Neon PostgreSQL (Step 5+)
DATABASE_URL=
